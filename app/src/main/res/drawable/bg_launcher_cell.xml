<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="135" android:startColor="#D564E8E8" android:endColor="#A329415D" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="135" android:startColor="#A638516D" android:endColor="#7315263B" />
            <stroke android:width="1dp" android:color="@color/fb_glass_outline" />
        </shape>
    </item>
</selector>
